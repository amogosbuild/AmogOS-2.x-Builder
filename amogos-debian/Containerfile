# A Debian 13 userspace supplies the native bootstrap and hybrid ISO tools.
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 debootstrap git ca-certificates gnupg dpkg-dev grub-pc-bin grub-efi-amd64-bin grub-common xorriso squashfs-tools mtools dosfstools util-linux file && apt-get clean && rm -rf /var/lib/apt/lists/*
