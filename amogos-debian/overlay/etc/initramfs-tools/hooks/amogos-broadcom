#!/bin/sh
set -e
case "$1" in prereqs) exit 0;; esac
. /usr/share/initramfs-tools/hook-functions
if modinfo -k "$version" wl >/dev/null 2>&1; then
    manual_add_modules wl
    copy_file config /usr/lib/udev/rules.d/70-amogos-broadcom.rules || test -r "$DESTDIR/usr/lib/udev/rules.d/70-amogos-broadcom.rules"
fi
